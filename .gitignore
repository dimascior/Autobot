# Machine-specific config (absolute paths) -- never publish
config.local.toml

# One-cycle live configs (dry_run = false) -- never make these the default
config.*-run.toml

# Live backlog holds real internal threads -- ship backlog.example.toml instead
backlog.toml

# Local state / ledger (and its backups)
*.db
*.db.bak*

# Pilot evidence bundles (preserved DB + CAS + call snapshots)
pilot-evidence-*/

# CAS object store (produced by seed/run, never committed)
store/

# Python
__pycache__/
*.pyc
.venv/

# Build / editable-install artifacts
*.egg-info/
build/
dist/
