{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autobot/object/VerificationReceipt/v1",
  "title": "VerificationReceipt (obj-19): the verifier_runner's authoritative satisfaction of one contract part. Three registered arms (C4-M2 amendment, exactly one matches): BY_VERIFIER over a DETERMINISTIC assertion (the C4-M1 shape — exact candidate, environment, assertion part, verifier registration and Attempt bound per INV-17, with the execution provenance of the exact registered closure per INV-66); BY_VERIFIER over a ROLE_TRANSFORM part (INV-44/INV-49: the registered transform's recomputed output vs the producer-recorded prompt identity, carried in transform_check); BY_ATTESTATION (D-52/D-53: your admitted obj-37 backs an ATTESTED result for a HUMAN_ATTESTED assertion — a human act, so no registration, no execution, no environment)",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version", "kind", "minter",
        "attempt", "attempt_contract_hash", "record_hash",
        "candidate_receipt_sha256", "environment_sha256",
        "assertion", "registration", "result_source", "outcome", "execution"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "v1"},
        "kind": {"const": "VerificationReceipt"},
        "minter": {"const": "verifier_runner"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "attempt_contract_hash": {"$ref": "#/$defs/digest"},
        "record_hash": {"$ref": "#/$defs/digest"},
        "candidate_receipt_sha256": {"$ref": "#/$defs/digest"},
        "environment_sha256": {"$ref": "#/$defs/digest"},
        "assertion": {
          "type": "object",
          "required": ["part", "verifier_id", "mode"],
          "additionalProperties": false,
          "properties": {
            "part": {"$ref": "#/$defs/assertion_part"},
            "verifier_id": {"$ref": "#/$defs/name_id"},
            "mode": {"const": "DETERMINISTIC"}
          }
        },
        "registration": {"$ref": "#/$defs/registration"},
        "result_source": {"const": "BY_VERIFIER"},
        "outcome": {"const": "PASS"},
        "execution": {"$ref": "#/$defs/execution"}
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version", "kind", "minter",
        "attempt", "attempt_contract_hash", "record_hash",
        "candidate_receipt_sha256", "environment_sha256",
        "assertion", "registration", "result_source", "outcome",
        "execution", "transform_check"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "v1"},
        "kind": {"const": "VerificationReceipt"},
        "minter": {"const": "verifier_runner"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "attempt_contract_hash": {"$ref": "#/$defs/digest"},
        "record_hash": {"$ref": "#/$defs/digest"},
        "candidate_receipt_sha256": {"$ref": "#/$defs/digest"},
        "environment_sha256": {"$ref": "#/$defs/digest"},
        "assertion": {
          "type": "object",
          "required": ["part", "verifier_id", "mode"],
          "additionalProperties": false,
          "properties": {
            "part": {"$ref": "#/$defs/transform_part"},
            "verifier_id": {"$ref": "#/$defs/name_id"},
            "mode": {"const": "DETERMINISTIC"}
          }
        },
        "registration": {"$ref": "#/$defs/registration"},
        "result_source": {"const": "BY_VERIFIER"},
        "outcome": {"const": "PASS"},
        "execution": {"$ref": "#/$defs/execution"},
        "transform_check": {
          "type": "object",
          "required": ["input_name", "input_sha256", "expected_sha256", "observed_sha256"],
          "additionalProperties": false,
          "properties": {
            "input_name": {"$ref": "#/$defs/name_id"},
            "input_sha256": {"$ref": "#/$defs/digest"},
            "expected_sha256": {"$ref": "#/$defs/digest"},
            "observed_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version", "kind", "minter",
        "attempt", "attempt_contract_hash", "record_hash",
        "candidate_receipt_sha256",
        "assertion", "result_source", "outcome", "attestation_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "v1"},
        "kind": {"const": "VerificationReceipt"},
        "minter": {"const": "verifier_runner"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "attempt_contract_hash": {"$ref": "#/$defs/digest"},
        "record_hash": {"$ref": "#/$defs/digest"},
        "candidate_receipt_sha256": {"$ref": "#/$defs/digest"},
        "assertion": {
          "type": "object",
          "required": ["part", "mode"],
          "additionalProperties": false,
          "properties": {
            "part": {"$ref": "#/$defs/assertion_part"},
            "mode": {"const": "HUMAN_ATTESTED"}
          }
        },
        "result_source": {"const": "BY_ATTESTATION"},
        "outcome": {"const": "ATTESTED"},
        "attestation_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "name_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "attempt": {
      "type": "object",
      "required": ["sequence_id", "attempt_id", "fence"],
      "additionalProperties": false,
      "properties": {
        "sequence_id": {"type": "string", "pattern": "^sq_[0-9a-f]{32}$"},
        "attempt_id": {"type": "string", "pattern": "^at_[0-9a-f]{32}$"},
        "fence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "registration": {
      "type": "object",
      "required": ["object_sha256", "registration_id", "artifact_root"],
      "additionalProperties": false,
      "properties": {
        "object_sha256": {"$ref": "#/$defs/digest"},
        "registration_id": {"type": "string", "pattern": "^rg_[0-9a-f]{32}$"},
        "artifact_root": {"$ref": "#/$defs/digest"}
      }
    },
    "assertion_part": {
      "type": "object",
      "required": ["record", "part_kind", "part_id"],
      "additionalProperties": false,
      "properties": {
        "record": {"$ref": "#/$defs/digest"},
        "part_kind": {"const": "ASSERTION"},
        "part_id": {"$ref": "#/$defs/name_id"}
      }
    },
    "transform_part": {
      "type": "object",
      "required": ["record", "part_kind", "part_id"],
      "additionalProperties": false,
      "properties": {
        "record": {"$ref": "#/$defs/digest"},
        "part_kind": {"const": "ROLE_TRANSFORM"},
        "part_id": {"$ref": "#/$defs/name_id"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["closure_kind", "entrypoint", "exit_code", "output_sha256"],
      "additionalProperties": false,
      "properties": {
        "closure_kind": {"enum": ["native", "python", "packaged"]},
        "entrypoint": {"type": "string", "pattern": "^[^\\\\/\\s][^\\\\]*$"},
        "exit_code": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "output_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
