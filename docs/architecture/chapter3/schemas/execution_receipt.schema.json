{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autobot/object/ExecutionReceipt/v1",
  "title": "ExecutionReceipt (obj-15): the collector's authoritative completeness classification over admitted evidence, with the C3-M2 causal evidence graph and the C3-M3 input re-hash binding",
  "type": "object",
  "required": [
    "schema_version", "kind", "minter",
    "attempt_id", "attempt_contract_hash", "call_id",
    "completeness", "completeness_by_role", "member_completeness",
    "admitted_witnesses", "integrity_failures",
    "causal_joins", "contradictions", "artifact_provenance",
    "input_rehash", "derivation", "evidence_complete_by_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v1"},
    "kind": {"const": "ExecutionReceipt"},
    "minter": {"const": "collector"},
    "attempt_id": {"type": "string", "pattern": "^at_[0-9a-f]{32}$"},
    "attempt_contract_hash": {"$ref": "#/$defs/digest"},
    "call_id": {"type": "string", "pattern": "^call_[0-9a-f]{32}$"},
    "native_session_id": {"type": "string", "pattern": "^\\S(?:[^\\n]*\\S)?$"},
    "completeness": {"enum": ["COMPLETE", "INCOMPLETE", "INTEGRITY_FAILED"]},
    "completeness_by_role": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name_id"},
      "additionalProperties": {
        "type": "object",
        "required": ["required_kinds", "present_kinds", "missing_kinds"],
        "additionalProperties": false,
        "properties": {
          "required_kinds": {"$ref": "#/$defs/kind_list"},
          "present_kinds": {"$ref": "#/$defs/kind_list"},
          "missing_kinds": {"$ref": "#/$defs/kind_list"}
        }
      }
    },
    "member_completeness": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name_id"},
      "additionalProperties": {
        "type": "object",
        "required": ["required", "attributed"],
        "additionalProperties": false,
        "properties": {
          "required": {"type": "boolean"},
          "attributed": {"type": "boolean"},
          "reported_outcomes": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "pattern": "^\\S(?:[^\\n]*\\S)?$"}
          }
        }
      }
    },
    "admitted_witnesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/admission_entry"}
    },
    "integrity_failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/admission_entry"}
    },
    "causal_joins": {
      "type": "array",
      "items": {"$ref": "#/$defs/causal_join"}
    },
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contradiction"}
    },
    "artifact_provenance": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_event"}
    },
    "input_rehash": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name_id"},
      "additionalProperties": {
        "type": "object",
        "required": ["content_sha256", "intact"],
        "additionalProperties": false,
        "properties": {
          "content_sha256": {"$ref": "#/$defs/digest"},
          "intact": {"type": "boolean"}
        }
      }
    },
    "derivation": {
      "type": "object",
      "required": ["rule", "anchor_utc", "window_seconds"],
      "additionalProperties": false,
      "properties": {
        "rule": {"const": "ch3:evidence-window-after-freeze"},
        "anchor_utc": {"$ref": "#/$defs/instant"},
        "window_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "evidence_complete_by_utc": {"$ref": "#/$defs/instant"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "instant": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"},
    "name_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "principal": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "witness_kind": {"enum": ["obj-11", "obj-12", "obj-13", "obj-14"]},
    "kind_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/witness_kind"}
    },
    "admission_entry": {
      "type": "object",
      "required": ["witness_kind", "producer", "content_sha256"],
      "additionalProperties": false,
      "properties": {
        "witness_kind": {"$ref": "#/$defs/witness_kind"},
        "producer": {"$ref": "#/$defs/principal"},
        "content_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "causal_join": {
      "type": "object",
      "required": ["witness_kind", "producer", "content_sha256", "join"],
      "additionalProperties": false,
      "properties": {
        "witness_kind": {"$ref": "#/$defs/witness_kind"},
        "producer": {"$ref": "#/$defs/principal"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "join": {"enum": ["JOINED", "UNJOINED", "CONTRADICTED"]},
        "controller_well_formed": {"type": "boolean"},
        "facts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {}
        }
      }
    },
    "contradiction": {
      "type": "object",
      "required": ["rule"],
      "additionalProperties": false,
      "properties": {
        "rule": {"enum": ["cross_execution_identity", "deny_then_ran", "execution_without_decision"]},
        "witness_kind": {"$ref": "#/$defs/witness_kind"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "session_id": {"type": "string", "pattern": "^$|^\\S(?:[^\\n]*\\S)?$"},
        "tool_use_id": {"type": "string", "pattern": "^\\S(?:[^\\n]*\\S)?$"}
      }
    },
    "artifact_event": {
      "type": "object",
      "required": ["logical_path", "content_sha256", "role"],
      "additionalProperties": false,
      "properties": {
        "logical_path": {"type": "string", "pattern": "^\\S(?:[^\\n]*\\S)?$"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "role": {"$ref": "#/$defs/name_id"}
      }
    }
  }
}
