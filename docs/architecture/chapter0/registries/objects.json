{
  "schema": "autobot-ch0-objects/v1",
  "classes": {
    "authority_record": "a decision record you (or an authenticated request) create",
    "contract": "a frozen contract object",
    "contract_part": "a part frozen inside a contract",
    "state": "a CAS-updated lifecycle row",
    "receipt": "an authoritative, deterministic record of a fact",
    "non_authoritative_receipt": "a record of a fact that grants nothing",
    "witness": "a record written by an external producer",
    "journal": "an append-only event record",
    "intent": "a bounded authorization for one effect",
    "permit_state": "permit counters and reservations",
    "obligation": "a durable duty to repair",
    "lease": "a renewable claim",
    "legacy": "imported read-only history"
  },
  "storage_policy": {
    "decision": "D-04",
    "authoritative": ["ledger", "content_store"],
    "ledger": "authoritative metadata, identities, hashes, bindings, state transitions and receipt references",
    "content_store": "immutable receipt payloads and retained evidence and artifact bytes, addressed by hash",
    "index_only": ["hdb"],
    "source_proof_only": ["git"],
    "note": "HDB never gates completeness, acceptance or state unless a TaskContract declares an HDB-derived assertion; Git carries source proof and path-free trailers only"
  },
  "storage_by_class": {
    "authority_record": "ledger+content_store",
    "contract": "ledger+content_store",
    "contract_part": "ledger",
    "state": "ledger",
    "receipt": "ledger+content_store",
    "non_authoritative_receipt": "ledger+content_store",
    "witness": "producer original; admitted copy in content_store, referenced from the ledger",
    "journal": "ledger",
    "intent": "ledger",
    "permit_state": "ledger",
    "obligation": "ledger",
    "lease": "ledger",
    "legacy": "ledger"
  },
